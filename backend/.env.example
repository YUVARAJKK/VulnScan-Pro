NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vulnscan_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:3000

# SMTP (Mailtrap for development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vulnscan-pro.local

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Reports
REPORTS_DIR=./reports
