# VulnScan Pro — Scanner Worker Dockerfile
# Includes both Node.js backend and Python scanner engine

FROM node:20-slim AS node-stage

# Install Python and dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Set up Python environment
RUN python3 -m venv /opt/scanner-venv
ENV PATH="/opt/scanner-venv/bin:$PATH"

# Copy and install Python dependencies
COPY scanner_engine/requirements.txt /app/scanner_engine/requirements.txt
RUN pip3 install --no-cache-dir -r /app/scanner_engine/requirements.txt

# Copy Python scanner engine
COPY scanner_engine/ /app/scanner_engine/

# Copy Node.js backend
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --only=production
COPY backend/ .

# Set working directory
WORKDIR /app

# Default command (overridden by docker-compose)
CMD ["node", "src/workers/scanWorker.js"]
